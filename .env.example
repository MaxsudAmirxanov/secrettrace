# Local development (outside Docker). Every sensitive ST_X may be given as ST_X_FILE instead.
ST_LISTEN_ADDR=127.0.0.1:8080
ST_DATABASE_URL=postgres://st_app:app-test@127.0.0.1:54329/secrettrace
ST_MIGRATION_DATABASE_URL=postgres://st_owner:owner-test@127.0.0.1:54329/secrettrace
# Generate with: cargo run -p st-server -- gen-pepper --version 1
ST_PEPPER_KEYS=1:REPLACE_WITH_BASE64_32_BYTES
# ST_PEPPER_CURRENT=1          # defaults to the highest configured version
# AES-256-GCM key for TOTP seeds. Generate with: cargo run -p st-server -- gen-data-key
ST_DATA_KEY=REPLACE_WITH_BASE64_32_BYTES
# Auth
ST_COOKIE_SECURE=false         # true in production (adds Secure + __Host- prefix)
ST_SESSION_TTL_SECS=43200      # absolute session lifetime (12 h)
ST_SESSION_IDLE_SECS=1800      # idle timeout (30 min)
ST_TOTP_ISSUER=SecretTrace
# ST_TRUSTED_PROXIES=10.0.0.2  # comma-separated IPs whose X-Forwarded-For is trusted
ST_LOG_FORMAT=pretty           # json | pretty
ST_LOG=info
ST_DB_MAX_CONNECTIONS=10
ST_REQUEST_TIMEOUT_SECS=30
ST_MAX_BODY_BYTES=1048576
# Ingest: unique digests one API token may submit to /match per hour (oracle protection).
ST_INGEST_DIGESTS_PER_HOUR=200000
# Worker (`secrettrace-server worker`): needs ST_DATABASE_URL and ST_PEPPER_KEYS, not ST_DATA_KEY.
# ST_WORKER_ID=worker-1                      # lease owner name (default: host-pid-random)
ST_WORKER_DATA_DIR=./target/worker-data      # bare mirrors: <dir>/repos/<source_id>.git
# ST_WORKER_TMP_DIR=/tmp                     # per-job private dirs (credential copies, git HOME)
# Files named by sources.credential_ref. Each credential <ref> needs <ref>.hosts next to it:
# one host per line (# comments), the only hosts it is ever sent to.
ST_WORKER_CREDENTIALS_DIR=./deploy/worker/git-credentials
# ST_WORKER_SSH_KNOWN_HOSTS=./deploy/worker/ssh_known_hosts # required for ssh sources
# Hosts sources may point at; required unless ST_WORKER_ALLOW_ANY_HOST=true. IP literals
# only when listed literally.
ST_WORKER_ALLOWED_HOSTS=github.com
# ST_WORKER_ALLOW_ANY_HOST=false
ST_WORKER_CONCURRENCY=1                      # jobs in parallel (1-16)
# ST_WORKER_SCAN_THREADS=8                   # extraction threads per job (default: CPUs)
ST_WORKER_JOB_TIMEOUT_SECS=1800              # fetch + scan of one job
ST_WORKER_LEASE_TIMEOUT_SECS=300             # a job without heartbeat for this long is reclaimed
ST_WORKER_POLL_INTERVAL_SECS=5
ST_WORKER_MAX_ATTEMPTS=3                     # retries use exponential backoff from 60 s
ST_WORKER_MAX_BLOB_BYTES=16777216
ST_WORKER_MAX_REPO_BYTES=2147483648          # a fetch growing the mirror past this is stopped
ST_WORKER_ALLOW_LOCAL_REPOS=false            # true allows file:// and absolute paths (development only)
# Built web UI to serve on non-API paths (web/dist). Empty: API only.
ST_WEB_DIR=
