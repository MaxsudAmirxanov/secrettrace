          "digest": {
            "type": "string",
            "description": "`SHA-256(\"secrettrace/v1\\0\" || normalize(value))`, lowercase hex.",
            "pattern": "^[0-9a-f]{64}$"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
