      },
      "SecretCreate": {
        "type": "object",
        "description": "Registration request. `digest` is computed client-side (`secrettrace digest`\nor the web UI); the plaintext value is never sent.",
        "required": [
          "name",
          "type",
          "owner",
          "digest"
        ],
        "properties": {
          "allow_rules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AllowRuleIn"
            }
